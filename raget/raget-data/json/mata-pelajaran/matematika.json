    "teks": "Diskriminan (D = b² - 4ac) pada persamaan kuadrat menentukan jenis akar: D > 0 dua akar real berbeda, D = 0 satu akar kembar, D < 0 tidak ada akar real.",
    "meta": {
      "field": "matematika",
      "topic": "Diskriminan",
      "tags": [
        "diskriminan",
        "persamaan kuadrat"
      ],
      "rumus": "D = b^2 - 4ac"
    }
  },
