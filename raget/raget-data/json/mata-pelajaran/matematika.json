  {
    "id": "mapel-matematika-luas-dan-keliling-lingkaran",
    "kategori": "mata-pelajaran",
    "wilayah": "matematika",
    "nama": "Luas dan Keliling Lingkaran",
    "tags": [
      "lingkaran",
      "luas",
      "keliling"
    ],
    "teks": "Luas lingkaran L = π × r²; keliling lingkaran K = 2 × π × r, dengan r adalah jari-jari lingkaran dan π ≈ 3,14 atau 22/7.",
    "meta": {
      "field": "matematika",
      "topic": "Luas dan Keliling Lingkaran",
      "tags": [
        "lingkaran",
        "luas",
        "keliling"
      ],
      "rumus": "L=pi.r^2; K=2.pi.r"
    }
  },
  {
    "id": "mapel-matematika-luas-segitiga",
    "kategori": "mata-pelajaran",
    "wilayah": "matematika",
    "nama": "Luas Segitiga",
    "tags": [
      "segitiga",
      "luas"
    ],
    "teks": "Luas segitiga = ½ × alas × tinggi. Untuk segitiga dengan tiga sisi diketahui, bisa juga dihitung pakai rumus Heron.",
