      "topic": "Luas Segitiga",
      "tags": [
        "segitiga",
        "luas"
      ],
      "rumus": "L = 1/2 x alas x tinggi"
    }
  },
  {
    "id": "mapel-matematika-volume-bangun-ruang",
    "kategori": "mata-pelajaran",
    "wilayah": "matematika",
    "nama": "Volume Bangun Ruang",
    "tags": [
      "volume",
      "bangun ruang",
      "kubus",
      "tabung",
      "bola"
    ],
    "teks": "Volume balok = panjang × lebar × tinggi; volume kubus = sisi³; volume tabung = π × r² × tinggi; volume bola = 4/3 × π × r³; volume kerucut = 1/3 × π × r² × tinggi.",
    "meta": {
      "field": "matematika",
      "topic": "Volume Bangun Ruang",
      "tags": [
        "volume",
        "bangun ruang",
        "kubus",
        "tabung",
        "bola"
      ],
      "rumus": "V_balok=p.l.t; V_kubus=s^3; V_tabung=pi.r^2.t; V_bola=4/3.pi.r^3"
    }
  },
  {
    "id": "mapel-matematika-persamaan-kuadrat",
    "kategori": "mata-pelajaran",
    "wilayah": "matematika",
    "nama": "Persamaan Kuadrat",
    "tags": [
      "persamaan kuadrat",
      "rumus abc"
    ],
    "teks": "Persamaan kuadrat berbentuk ax² + bx + c = 0 diselesaikan dengan rumus abc: x = (-b ± √(b² - 4ac)) / 2a, dengan a ≠ 0.",
    "meta": {
      "field": "matematika",
      "topic": "Persamaan Kuadrat",
      "tags": [
        "persamaan kuadrat",
        "rumus abc"
      ],
      "rumus": "x = (-b +- akar(b^2-4ac)) / 2a"
    }
  },
